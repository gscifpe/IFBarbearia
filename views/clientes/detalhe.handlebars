<h2>Detalhes do cliente</h2>
<dl>
    <dt>Nome</dt><dd>{{cliente.nome}}</dd>
    <dt>E-mail</dt><dd>{{cliente.email}}</dd>
    <dt>Telefone</dt><dd>{{cliente.telefone}}</dd>
    <dt>CPF</dt><dd>{{cliente.cpf}}</dd>
    <dt>Data de nascimento</dt><dd>{{cliente.dataNascimento}}</dd>
    <dt>Ativo</dt><dd>{{cliente.ativo}}</dd>
</dl>
<p><a href="/clientes/{{cliente.id}}/editar">Editar</a> | <a href="/clientes">Voltar à listagem</a></p>
