<h2>Serviços</h2>
<p><a href="/servicos/novo">Cadastrar serviço</a></p>
{{#if servicos.length}}
    <table>
        <thead>
            <tr><th>Nome</th><th>Categoria</th><th>Duração (minutos)</th><th>Preço</th></tr>
        </thead>
        <tbody>
            {{#each servicos}}
                <tr>
                    <td>{{nome}}</td>
                    <td>{{Categoria.nome}}</td>
                    <td>{{duracaoMinutos}}</td>
                    <td>{{preco}}</td>
                </tr>
            {{/each}}
        </tbody>
    </table>
{{else}}
    <p>Nenhum serviço cadastrado.</p>
{{/if}}
